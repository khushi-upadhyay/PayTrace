# Normalize shell scripts to Unix LF line endings
*.sh text eol=lf

# Normalize Docker-related files
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Normalize configuration and source files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.py text eol=lf