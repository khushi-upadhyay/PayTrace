APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/paytrace

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI Provider Configuration
# Supported providers: "openai", "grok" (xAI), "groq"
# For OpenAI:
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini  (or gpt-4o)
# For Grok (xAI):
#   AI_PROVIDER=grok
#   AI_API_KEY=xai-...
#   AI_MODEL=grok-2-latest  (or grok-beta)
# For Groq (Llama / Mixtral):
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional custom base URL
# AI_BASE_URL=https://api.x.ai/v1

DEMO_OPERATOR_TOKEN=demo-operator-secret-token
AUTH_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
# Optional
OTEL_EXPORTER_OTLP_ENDPOINT=
APIMATIC_API_KEY=
